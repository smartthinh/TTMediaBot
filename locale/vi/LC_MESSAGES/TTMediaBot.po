#: D:/TTMediaBot/bot/__init__.py:141
msgid "Update completed successfully! I am back online."
msgstr "Cập nhật thành công! Bot đã hoạt động trở lại."

#: D:/TTMediaBot/bot/__init__.py:181
msgid ""
"The bot is starting an update process and will restart shortly. It may go"
" offline at any moment."
msgstr ""
"Bot đang bắt đầu cập nhật và sẽ khởi động lại trong giây lát. Bot có thể "
"ngắt kết nối bất cứ lúc nào."

#: D:/TTMediaBot/bot/__init__.py:219
msgid "The bot is restarting now to apply the update. See you in a moment!"
msgstr ""
"Bot đang khởi động lại để áp dụng bản cập nhật. Hẹn gặp lại bạn trong "
"giây lát!"

