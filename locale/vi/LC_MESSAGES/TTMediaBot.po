#: D:/TTMediaBot/bot/__init__.py:139
msgid "Update completed successfully! I am back online."
msgstr "Cập nhật thành công! Bot đã hoạt động trở lại."

#: D:/TTMediaBot/bot/__init__.py:178
msgid ""
"The bot is starting an update process and will restart shortly. It may go "
"offline at any moment."
msgstr ""
"Bot đang bắt đầu cập nhật và sẽ khởi động lại trong giây lát. Bot có thể ngắt "
"kết nối bất cứ lúc nào."

#: D:/TTMediaBot/bot/__init__.py:210
msgid "The bot is restarting now to apply the update. See you in a moment!"
msgstr ""
"Bot đang khởi động lại để áp dụng bản cập nhật. Hẹn gặp lại bạn trong giây lát!"

# #-#-#-#-#  catalog.po (TTMediaBot VERSION)  #-#-#-#-#
# | msgid "" "Hello, I'm Smart Thinh.\n" "This is a TTMediaBot edition for
# | TeamTalk 5, based on João Almeida's " "fork.\n" "Ported to run seamlessly
# on
# | Windows with high stability and ultra-fast " "response.\n" "Repository:
# | https://github.com/smartthinh/TTMediaBot\n" "\fOriginal Authors: Amir
# | Gumerov, Vladislav Kopylov, Beqa Gozalishvili, " "Kirill Belousov.\n"
#: D:/TTMediaBot/bot/app_vars.py:13
msgid ""
"Hello, I'm Smart Thinh.\n"
"This is a TTMediaBot edition for TeamTalk 5, based on João Almeida's fork.\n"
"Ported to run seamlessly on Windows with high stability and ultra-fast "
"response.\n"
"Repository: https://github.com/smartthinh/TTMediaBot\n"
"\fOriginal Authors: Amir Gumerov, Vladislav Kopylov, Beqa Gozalishvili, Kirill "
"Belousov.\n"
msgstr ""
"Xin chào, mình là Smart Thinh.\n"
"Đây là phiên bản TTMediaBot dành cho TeamTalk 5, dựa trên bản fork của João "
"Almeida.\n"
"Được chuyển sang chạy mượt trên Windows, rất ổn định và phản hồi cực nhanh.\n"
"Kho mã nguồn: https://github.com/smartthinh/TTMediaBot\n"
"\fTác giả gốc: Amir Gumerov, Vladislav Kopylov, Beqa Gozalishvili, Kirill "
"Belousov.\n"

