msgid ""
"[on/off/end/MINUTES] Checks timer status, enables/disables timer, stops "
"after current video/track ends, or sets timer in minutes (e.g., tm end, "
"tm 30, tm on, tm off)"
msgstr ""
"[on/off/end/MINUTOS] Verifica o estado do temporizador, ativa/desativa o "
"temporizador, para após o vídeo/faixa atual terminar ou define o tempo em"
" minutos (por exemplo, tm end, tm 30, tm on, tm off)"

#: D:/TTMediaBot/bot/commands/user_commands.py:2022
msgid "Sleep timer is not available."
msgstr "O temporizador de parada não está disponível."

#: D:/TTMediaBot/bot/commands/user_commands.py:2028
msgid "No sleep timer is currently active."
msgstr "Não há nenhum temporizador de parada ativo no momento."

#: D:/TTMediaBot/bot/commands/user_commands.py:2039
#, python-brace-format
msgid ""
"Sleep timer is active: playback will stop when current track "
"ends{time_part}."
msgstr ""
"O temporizador de parada está ativo: a reprodução será interrompida "
"quando a faixa atual terminar{time_part}."

#: D:/TTMediaBot/bot/commands/user_commands.py:2044
msgid "Sleep timer is about to stop playback."
msgstr "O temporizador de parada vai interromper a reprodução em breve."

#: D:/TTMediaBot/bot/commands/user_commands.py:2054
#, python-brace-format
msgid "Sleep timer is active: {time_str} remaining."
msgstr "O temporizador de parada está ativo: restam {time_str}."

#: D:/TTMediaBot/bot/commands/user_commands.py:2060
msgid "Sleep timer has been cancelled."
msgstr "O temporizador de parada foi cancelado."

#: D:/TTMediaBot/bot/commands/user_commands.py:2062
msgid "No sleep timer was active."
msgstr "Não havia nenhum temporizador de parada ativo."

#: D:/TTMediaBot/bot/commands/user_commands.py:2074
#, python-brace-format
msgid "Sleep timer set: playback will stop when current track ends{track_info}."
msgstr ""
"Temporizador de parada definido: a reprodução será interrompida quando a "
"faixa atual terminar{track_info}."

#: D:/TTMediaBot/bot/commands/user_commands.py:2080
#, python-brace-format
msgid "{nickname} set a sleep timer to stop music when current track ends."
msgstr ""
"{nickname} definiu um temporizador para parar a música quando a faixa "
"atual terminar."

#: D:/TTMediaBot/bot/commands/user_commands.py:2102
msgid "Error: Timer cannot be set for more than 24 hours (1440 minutes)."
msgstr ""
"Erro: o temporizador não pode ser definido para mais de 24 horas (1440 "
"minutos)."

#: D:/TTMediaBot/bot/commands/user_commands.py:2109
#, python-brace-format
msgid "Sleep timer set: music will stop in {duration}."
msgstr "Temporizador de parada definido: a música será interrompida em {duration}."

#: D:/TTMediaBot/bot/commands/user_commands.py:2116
#, python-brace-format
msgid "{nickname} set a sleep timer to stop music in {duration}."
msgstr "{nickname} definiu um temporizador para parar a música em {duration}."

#: D:/TTMediaBot/bot/commands/user_commands.py:2127
msgid "[MESSAGE] Sends a private message to the bot operator. Usage: pm <message>"
msgstr ""
"[MENSAGEM] Envia uma mensagem privada ao operador do bot. Uso: pm "
"<mensagem>"

#: D:/TTMediaBot/bot/commands/user_commands.py:2131
