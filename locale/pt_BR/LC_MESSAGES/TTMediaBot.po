#: D:/TTMediaBot/bot/__init__.py:139
msgid "Update completed successfully! I am back online."
msgstr "Atualização concluída com sucesso! Estou de volta."

#: D:/TTMediaBot/bot/__init__.py:178
msgid ""
"The bot is starting an update process and will restart shortly. It may go "
"offline at any moment."
msgstr ""
"O bot está iniciando o processo de atualização e será reiniciado em breve. "
"Ele pode ficar offline a qualquer momento."

#: D:/TTMediaBot/bot/__init__.py:210
msgid "The bot is restarting now to apply the update. See you in a moment!"
msgstr ""
"O bot está reiniciando agora para aplicar a atualização. Até daqui a pouco!"

